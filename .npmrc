# legacy-peer-deps is needed for two conflicts, and should go when both do:
#
# 1. @vercel/remix 2.16.7 — its final release — pins every @remix-run package
#    to exactly 2.16.7, while Remix itself is on 2.17.5. This disappears with
#    the move to React Router 7 and @vercel/react-router.
# 2. @csstools/postcss-global-data and postcss-custom-media pull different
#    major lines of @csstools/css-parser-algorithms and css-tokenizer through
#    their peer ranges. Upgrading both moves the conflict rather than
#    resolving it.
#
# Check with: npm install --dry-run --legacy-peer-deps=false
# Everything the site actually builds with is pinned in package-lock.json.
legacy-peer-deps=true
