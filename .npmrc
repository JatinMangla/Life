# @csstools/postcss-global-data and postcss-custom-media pull different major
# lines of @csstools/css-parser-algorithms and @csstools/css-tokenizer through
# their peer ranges. Upgrading both to their latest majors moves the conflict
# rather than resolving it, so this stays until the upstream ranges line up.
# Everything the site actually builds with is pinned in package-lock.json.
legacy-peer-deps=true
